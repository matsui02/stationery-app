<div class="flex flex-col items-center w-full max-w-xl mx-auto mt-[50px]">
  <% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
  <% end %>

  <h2 class="w-[400px] relative text-medium text-center text-[23px] text-gray-800 mb-[60px]">
    ログイン
    <p class="block absolute left-0 top-[60px] w-[400px] border-b-2 border-gray-700"></p>
  </h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field w-[400px] flex flex-col gap-1 mb-4">
    <p><%= f.label :email, class: "text-sm text-gray-500" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-3 py-2 rounded-sm font-normal outline-none border border-gray-200 focus:border-gray-400 placeholder:text-sm placeholder-gray-300 placeholder:font-light placeholder- text-gray-900 transition-colors duration-150" %></p>
  </div>

  <div data-controller="character-count" data-character-count-max-value="8">
    <div class="field w-[400px] flex flex-col gap-1">
      <p><%= f.label :password, class: "text-sm text-gray-500" %></p>
      <p><%= f.password_field :password, autofocus: true, autocomplete: "password",
       data: {
        character_count_target: "input",
        action: "input->character-count#update"
       },
       class: "w-full px-3 py-2 rounded-sm font-normal outline-none border border-gray-200 focus:border-gray-400 placeholder:text-sm placeholder-gray-300 placeholder:font-light placeholder- text-gray-900 transition-colors duration-150" %></p>
    </div>
    <div>
      <span id="countTarget" data-character-count-target="count" class="text-sm text-red-500">
        0 / 8 文字以上
      </span>
    </div>
  </div>

  <div class="actions mt-10">
    <%= f.submit "ログイン", class: "w-full h-11 rounded-sm  bg-black hover:bg-gray-800 transition-colors duration-150 text-white text-medium" %>
  </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
