<div class="flex flex-col items-center w-full max-w-xl mx-auto mt-[50px]">
  <h2 class="w-[400px] relative text-medium text-center text-[23px] text-gray-800 mb-[60px]">
    新規登録
    <p class="block absolute left-0 top-[60px] w-[400px] border-b-2 border-gray-700"></p>
  </h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field w-[400px] flex flex-col gap-1 mb-4">
    <p><%= f.label :name, class: "text-sm text-gray-500" %></p>
    <p><%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "ユーザー名を入力して下さい", class: "w-full px-3 py-2 rounded-sm font-normal outline-none border border-gray-200 focus:border-gray-400 placeholder:text-sm placeholder-gray-300 placeholder:font-light placeholder- text-gray-900 transition-colors duration-150" %></p>
  </div>

  <div class="field w-[400px] flex flex-col gap-1">
    <p><%= f.label :email, class: "text-sm text-gray-500" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "sample@example.com", class: "w-full px-3 py-2 rounded-sm font-normal outline-none border border-gray-200 focus:border-gray-400 placeholder:text-sm placeholder-gray-300 placeholder:font-light placeholder- text-gray-900 transition-colors duration-150" %></p>
  </div>

  <div data-controller=" password-visibility character-count password-confirmation" data-character-count-max-value="8" class=" field w-[400px] flex flex-col gap-2 mt-[20px]">
    <p><%= f.label :password, class: "text-sm text-gray-500" %></p>
    <div data-password-visibility-target="input" class="relative">
      <%= f.password_field :password, autocomplete: "new-password", placeholder: "パスワード (8文字以上)" ,
      data: {
        character_count_target: "input",
        action: "input->character-count#update input->password-confirmation#check",
      },
      id: "password",
      class: "w-full px-3 py-2 rounded-sm font-normal outline-none border border-gray-200 focus:border-gray-400 placeholder:text-sm placeholder-gray-300 placeholder:font-light placeholder- text-gray-900 transition-colors duration-150" %>
      <svg data-password-visibility-target="openIcon" data-action="click->password-visibility#toggle click->password-visibility#open" xmlns="http: //www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="text-gray-500 hover:text-gray-400 absolute top-[50%] translate-y-[-50%] right-[10px] size-6 transition-color duration-150">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
      </svg>
      <svg data-password-visibility-target="closedIcon" data-action="click->password-visibility#toggle click->password-visibility#open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="text-gray-500 hover:text-gray-400 absolute top-[50%] translate-y-[-50%] right-[10px] size-6 transition-color duration-150 hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
      </svg>
    </div>
    <div>
      <span id="countTarget" data-character-count-target="count" class="text-sm text-red-500">
        0 / 8 文字以上
      </span>
    </div>

    <div class="field w-[400px] flex flex-col gap-2 mt-[20px]">
      <p><%= f.label :password_confirmation, class: "text-sm text-gray-500" %></p>
      <p><%= f.password_field :password_confirmation, autocomplete: "new-password",
    placeholder: "もう一度入力" ,
    data: {
      password_confirmation_target: "input",
      action: "input->password-confirmation#check"
    },
    class: "w-full px-3 py-2 rounded-sm font-normal outline-none border border-gray-200 focus:border-gray-400 placeholder:text-sm placeholder-gray-300 placeholder:font-light text-gray-900 transition-colors duration-150" %></p>
      <p data-password-confirmation-target="checkText" class="text-sm text-red-500"></p>
    </div>
  </div>

  <div class="actions mt-10">
    <%= f.submit "新規登録", class: "w-full h-11 rounded-sm  bg-black hover:bg-gray-800 transition-colors duration-150 text-white text-medium" %>
  </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
