<header class="flex items-center justify-between border-b border-gray-200 bg-white px-[50px] py-[20px]">
  <%= link_to root_path do %>
  <h1 class="font-noto-serif text-[50px]">
    Pencase
  </h1>
  <% end %>

  <% if user_signed_in? %>
  <nav class="flex items-center gap-6">
    <%= link_to "筆箱一覧",
      "#",
      class: "font-medium text-gray-700 hover:text-black transition-colors" %>

    <%= link_to "投稿する",
      "#",
      class: "font-medium text-gray-700 hover:text-black transition-colors" %>

    <%= link_to "ログアウト",
      destroy_user_session_path,
      data: { turbo_method: :delete },
      class: "px-6 h-11 flex items-center justify-center rounded-md bg-black text-white font-medium hover:bg-gray-800 transition-colors" %>
  </nav>
  <% elsif controller_name != "accounts" && controller_name != "registrations" %>
  <div class="flex gap-4">
    <%= link_to "新規登録", accounts_path(tab: "signup"),
            class: "px-6 h-11 flex items-center justify-center rounded-md border border-black bg-white text-black font-medium hover:bg-gray-100 transition-colors" %>

    <%= link_to "ログイン", accounts_path(tab: "login"),
            class: "px-6 h-11 flex items-center justify-center rounded-md bg-black text-white font-medium hover:bg-gray-800 transition-colors" %>
  </div>
  <% end %>
</header>