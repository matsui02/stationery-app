<section class="px-[50px] py-[80px]">
  <%= render "shared/section_header",
        title:      "Ranking",
        subtitle:   "ランキング",
        link_label: nil,
        link_path:  nil %>
  <%= render "shared/tabs",
      tabs: [
        { label: "筆箱紹介" },
        { label: "お気に入りの1本" },
      ],
      wrapper_class: "w-full" %>
  <section class="px-[50px] py-[80px]">
    <%= render "shared/section_header",
        title:      "Ranking",
        subtitle:   "ランキング",
        link_label: nil,
        link_path:  nil %>

    <div data-controller="tabs">
      <%= render "shared/tabs",
          tabs: [
            { label: "筆箱紹介" },
            { label: "お気に入りの1本" }
          ],
          wrapper_class: "w-full" %>

      <%# 筆箱紹介タブ %>
      <div data-tabs-target="panel" class="mt-6">
        <% if @pencil_case_ranking.present? %>
        <div class="grid grid-cols-12 gap-4">
          <%# 1位：大きく表示 %>
          <div class="col-span-6">
            <%= render "shared/ranking_card",
              post: @pencil_case_ranking.first,
              rank: 1 %>
          </div>

          <%# 2〜5位：2列で表示 %>
          <div class="col-span-6 grid grid-cols-2 gap-4">
            <% @pencil_case_ranking.drop(1).each_with_index do |post, i| %>
            <%= render "shared/ranking_card",
                post: post,
                rank: i + 2 %>
            <% end %>
          </div>
        </div>
        <% else %>
        <p class="text-sm text-gray-400 tracking-wide">
          まだ投稿がありません
        </p>
        <% end %>
      </div>

      <%# お気に入りの1本タブ（未実装） %>
      <div data-tabs-target="panel" class="mt-6 hidden">
        <p class="text-sm text-gray-400 tracking-wide">
          まだ投稿がありません
        </p>
      </div>
    </div>
  </section>