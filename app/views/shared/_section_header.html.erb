<div class="flex items-end justify-between mb-8">
  <div class="flex items-baseline gap-3">
    <h2 class="font-serif text-3xl font-medium tracking-wide text-gray-900">
      <%= title %>
    </h2>
    <span class="text-sm text-gray-400 tracking-widest">
      / <%= subtitle %>
    </span>
  </div>
  <% if defined?(link_label) && link_label.present? &&
        defined?(link_path) && link_path.present? %>
  <%= link_to link_label, link_path,
        class: "text-xs border border-gray-800
                px-4 py-2 rounded-full
                hover:bg-gray-800 hover:text-white
              transition-colors duration-300" %>
  <% end %>
</div>