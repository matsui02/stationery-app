<%# app/views/shared/_section_header.html.erb %>
<div class="flex items-center justify-between mb-6">
  <div class="flex items-baseline gap-3">
    <h2 class="font-serif text-lg font-semibold tracking-wide">
      <%= title %>
    </h2>
    <small class="text-xs text-gray-400 tracking-widest">
      / <%= subtitle %>
    </small>
  </div>
  <% if defined?(link_label) && link_label.present? &&
        defined?(link_path) && link_path.present? %>
  <%= link_to link_label, link_path,
          class: "text-xs border border-gray-800 px-3 py-1.5
                  rounded hover:bg-gray-800 hover:text-white
                  transition-colors duration-150" %>
  <% end %>
</div>