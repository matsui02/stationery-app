<%# app/views/shared/_flash.html.erb %>
<% if flash[:notice].present? %>
<div data-controller="flash" data-flash-message-value="<%= j flash[:notice] %>" data-flash-type-value="notice">
</div>
<% end %>

<% if flash[:alert].present? %>
<div data-controller="flash" data-flash-message-value="<%= j flash[:alert] %>" data-flash-type-value="alert">
</div>
<% end %>