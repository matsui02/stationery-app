<div class="flex border-b border-gray-300 mt-[30px] <%= wrapper_class %>">
  <% tabs.each_with_index do |tab, i| %>
  <button type="button" data-tabs-target="tab" data-action="click->tabs#switch" class="px-6 py-4 border-b-2 text-sm tracking-wide
             transition-colors duration-150
             <%= i.zero? ? 'border-black text-black'
                         : 'border-transparent text-gray-500' %>
             <%= tab[:class] %>">
    <%= tab[:label] %>
  </button>
  <% end %>
</div>
