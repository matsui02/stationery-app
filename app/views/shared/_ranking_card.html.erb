<%# app/views/shared/_ranking_card.html.erb %>
<div class="group cursor-pointer" onclick="location.href='<%= pencil_case_path(post) %>'">

  <%# 画像エリア %>
  <div class="relative overflow-hidden rounded-sm
              <%= rank == 1 ? 'aspect-[16/9]' : 'aspect-[4/3]' %>
              bg-gray-100">

    <% if post.image.attached? %>
    <%= image_tag post.image.variant(resize_to_fill: [600, 400]),
            class: "w-full h-full object-cover
                    group-hover:scale-105 transition-transform
                    duration-300" %>
    <% else %>
    <div class="w-full h-full bg-gradient-to-br
                  from-gray-200 to-gray-300 flex items-center
                  justify-center">
      <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182
                   0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25
                   0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5
                   0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5
                   1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5
                   -11.25h.008v.008h-.008V8.25zm.375 0a.375.375
                   0 11-.75 0 .375.375 0 01.75 0z" />
      </svg>
    </div>
    <% end %>

    <%# 順位バッジ %>
    <div class="absolute top-3 left-3">
      <span class="<%= rank == 1 ?
                        'bg-black text-white text-sm w-8 h-8' :
                        'bg-white/90 text-black text-xs w-6 h-6' %>
                   rounded-full flex items-center justify-center
                   font-serif font-semibold shadow-sm">
        <%= rank %>
      </span>
    </div>

    <%# いいね数（いいね機能実装後に変更） %>
    <div class="absolute bottom-3 right-3">
      <span class="bg-black/50 text-white text-xs px-2 py-1
               rounded-full flex items-center gap-1">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
          <path d="M11.645 20.91l-.007-.003-.022-.012a15.247
               15.247 0 01-.383-.218 25.18 25.18 0
               01-4.244-3.17C4.688 15.36 2.25 12.174 2.25
               8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0
               0112 5.052 5.5 5.5 0 0116.313 3c2.973 0
               5.437 2.322 5.437 5.25 0 3.925-2.438
               7.111-4.739 9.256a25.175 25.175 0
               01-4.244 3.17 15.247 15.247 0
               01-.383.219l-.022.012-.007.004-.003.001a.752.752
               0 01-.704 0l-.003-.001z" />
        </svg>
        0
      </span>
    </div>

    <%# テキストエリア %>
    <div class="mt-2">
      <p class="text-xs text-gray-400 tracking-wide mb-0.5">
        <%= post.user.name %>
      </p>
      <p class="text-sm font-medium text-gray-900 leading-snug
              line-clamp-2">
        <%= post.title %>
      </p>
    </div>
  </div>