<div class="grid grid-cols-12 gap-4 mt-5">
  <div class="col-span-1 flex items-end justify-center">
    <span class="block w-7 h-7 border border-gray-400 rounded-full"></span>
  </div>
  <div class="col-span-4 flex flex-col">
    <%= f.label :new_item_name, "商品名", class: "text-sm text-gray-400 mb-1" %>
    <%= f.text_field :new_item_name, placeholder: "商品名で検索または入力", class: "px-2 py-1 border border-gray-400 rounded-sm placeholder:text-[14px] outline-none focus:border-black focus:ring-1 focus:ring-gray-300" %>
  </div>
  <div class="col-span-3 flex flex-col">
    <%= f.label :new_brand_name, "ブランド", class: "text-sm text-gray-400 mb-1" %>
    <%= f.text_field :new_brand_name, placeholder: "ブランド", class: "px-2 py-1 border border-gray-400 rounded-sm placeholder:text-[14px] outline-none focus:border-black focus:ring-1 focus:ring-gray-300" %>
  </div>
  <div class="col-span-4 flex flex-col">
    <%= f.label :new_category_id, "カテゴリ", class: "text-sm text-gray-400 mb-1" %>
    <%= f.text_field :new_category_id, placeholder: "カテゴリ", class: "px-2 py-1 border border-gray-400 rounded-sm placeholder:text-[14px] outline-none focus:border-black focus:ring-1 focus:ring-gray-300" %>
  </div>
</div>
<div class="w-fit px-3 py-1 mt-5 text-sm text-gray-500 border border-gray-400">
  <button type="button">
    アイテムを追加
  </button>
</div>
