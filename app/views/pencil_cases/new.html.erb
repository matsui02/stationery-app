<%= render "shared/tabs", wrapper_class: "w-full max-w-xl mx-auto",
tabs: [
 { label: "筆箱紹介", class: "flex-1" },
 { label: "お気に入りの1本", class: "flex-1" }
] %>

<%= form_with class: "w-full max-w-xl mx-auto mt-[40px]" ,model: @pencil_case do |f| %>
<div class="flex flex-col gap-3">
  <%= f.label :title, "タイトル", class: "text-md text-gray-500" %>
  <%= f.text_field :title, class: "w-full h-9 px-2 py-1 rounded-sm border border-gray-400 focus:border-gray-600 focus:ring-1 focus:ring-gray-300 outline-none placeholder:text-sm placeholder-gray-400 transition-colors duration-150", placeholder: "筆箱のタイトルを入力（50文字以内）" %>
  <span class="block text-right text-sm text-gray-400">0 / 50</span>
</div>
<div class="flex items-center justify-center mt-6 w-full h-40 border border-dashed border-gray-500 rounded-sm hover:border-black">
  <div class="flex flex-col items-center gap-2">
    <%= image_tag "image_upload.svg", class: "w-6 h-6 text-gray-300" %>
    <label for="image-upload" class="text-sm text-gray-400">
      筆箱の画像を選択
    </label>
  </div>
  <%= f.file_field :image, class: "hidden", id: "image-upload" %>
</div>
<%= f.fields_for :pencil_case_items do |item_form| %>
<%= render "item_fields", f: item_form %>
<% end %>
<div class="flex flex-col gap-3 mt-6">
  <%= f.label :concept, "コンセプト", class: "text-md text-gray-500" %>
  <%= f.text_area :concept, class: "w-full h-40 px-4 py-2 border border-gray-400 rounded-sm focus:border-gray-600 focus:ring-1 focus:ring-gray-300 outline-none placeholder:text-sm placeholder-gray-400 transition-colors duration-150" %>
  <span class="block text-right text-sm text-gray-400">0 / 500</span>
</div>
<%= f.submit "投稿する", class: "w-full px-4 py-3 bg-black text-white mt-4 hover:bg-gray-800 transition-colors duration-150" %>
<% end %>
