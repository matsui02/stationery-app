<div data-controller="item-search" data-item-search-categories-value=" <%= @categories.to_json %>">
  <div data-item-search-target="flash" class="hidden fixed top-5 right-5 px-4 py-2 bg-black text-white text-sm rounded"></div>
  <%= render "shared/tabs", wrapper_class: "w-full max-w-xl mx-auto",
    tabs: [
    { label: "筆箱紹介", class: "flex-1" },
    { label: "お気に入りの1本", class: "flex-1" }
    ] %>

  <%= form_with class: "w-full max-w-xl mx-auto mt-[40px]", model: @pencil_case do |f| %>
  <div data-controller="character-count" data-character-count-max-value="50">
    <div class="flex flex-col gap-3">
      <%= f.label :title, "タイトル", class: "text-md text-gray-500" %>
      <%= f.text_field :title,
    data: {
      character_count_target: "input",
      action: "input->character-count#update"
    },
    class: "w-full h-9 px-2 py-1 rounded-sm border border-gray-400 focus:border-gray-600 focus:ring-1 focus:ring-gray-300 outline-none placeholder:text-sm placeholder-gray-400 transition-colors duration-150", placeholder: "筆箱のタイトルを入力（50文字以内）" %>
      <span data-character-count-target="count" class="block text-right text-sm text-gray-400">0 / 50文字</span>
    </div>
  </div>
  <div data-controller="image-preview" data-action="click->image-preview#open" class="flex items-center justify-center mt-6 w-full h-40 border border-dashed border-gray-500 rounded-sm hover:border-black cursor-pointer">
    <div data-image-preview-target="placeholder" class="flex flex-col items-center gap-2">
      <%= image_tag "image_upload.svg", class: "w-6 h-6 text-gray-300" %>

      <span class="text-sm text-gray-400">
        筆箱の画像を選択
      </span>
    </div>

    <%= f.file_field :image,
      class: "hidden",
      id: "image-upload",
      data: {
        image_preview_target: "input",
        action: "change->image-preview#preview"
      } %>

    <img data-image-preview-target="preview" class="hidden max-h-36 max-w-full object-contain" alt="筆箱のプレビュー">
  </div>
  <% if @pencil_case.errors[:image].any? %>
  <p class="mt-1 text-sm text-red-500">
    <%= @pencil_case.errors[:image].first %>
  </p>
  <% end %>

  <!-- 現在のアイテム -->
  <%= f.fields_for :pencil_case_items do |item_form| %>
  <div class="item-row" data-controller="item-status">
    <%= render "item_fields",
          f: item_form,
          categories: @categories %>
    <% if item_form.object.errors[:base].any? %>
    <p class="mt-1 text-sm text-red-500">
      <%= item_form.object.errors[:base].first %>
    </p>
    <% end %>
    <% if @pencil_case.errors[:pencil_case_items].any? %>
    <p class="mt-1 text-sm text-red-500">
      <%= @pencil_case.errors[:pencil_case_items].first %>
    </p>
    <% end %>
  </div>
  <% end %>

  <!-- 追加用のひな形 -->
  <template data-item-search-target="template">
    <%= f.fields_for :pencil_case_items,
      PencilCaseItem.new,
      child_index: "NEW_RECORD" do |item_form| %>
    <div class="item-row" data-controller="item-status">
      <%= render "item_fields",
            f: item_form,
            categories: @categories %>
      <% if item_form.object.errors[:base].any? %>
      <p class="mt-1 text-sm text-red-500">
        <%= item_form.object.errors[:base].first %>
      </p>
      <% end %>
    </div>
    <% end %>
  </template>

  <!-- 表示エリア -->
  <div id="container"></div>

  <div class="w-fit px-3 py-1 mt-5 text-sm text-gray-500 border border-gray-400">
    <button data-action="click->item-search#addItem" type="button">
      アイテムを追加
    </button>
  </div>
  <div data-controller="character-count" data-character-count-max-value="500">
    <div class="flex flex-col gap-3 mt-6">
      <%= f.label :concept, "コンセプト", class: "text-md text-gray-500" %>
      <%= f.text_area :concept,
    data: {
      character_count_target: "input",
      action: "input->character-count#update"
    },
    class: "w-full h-40 px-4 py-2 border border-gray-400 rounded-sm focus:border-gray-600 focus:ring-1 focus:ring-gray-300 outline-none placeholder:text-sm placeholder-gray-400 transition-colors duration-150" %>
      <span data-character-count-target="count" class="block text-right text-sm text-gray-400">0 / 500文字</span>
    </div>
  </div>
  <%= f.submit "投稿する", class: "w-full px-4 py-3 bg-black text-white mt-4 hover:bg-gray-800 transition-colors duration-150" %>
  <% end %>
</div>
