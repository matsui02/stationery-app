<%= search_form_for @q, url: pencil_cases_path,
      html: { class: "flex items-center gap-2" } do |f| %>

<div class="relative">
  <div class="absolute inset-y-0 left-3 flex items-center
                pointer-events-none">
    <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196
                 5.196a7.5 7.5 0 0010.607 10.607z" />
    </svg>
  </div>
  <%= f.search_field :title_or_concept_cont,
          placeholder: "タイトル・コンセプトで検索",
          class: "w-100 h-9 border border-gray-200 rounded-full
                  pl-8 pr-3 text-xs text-gray-900
                  placeholder-gray-300 bg-white
                  focus:border-gray-400 focus:outline-none
                  transition-colors duration-150" %>
</div>

<%# 絞り込みボタン %>
<button type="button" data-action="click->drawer#toggle" class="h-9 px-4 border border-gray-200 rounded-full
                 text-xs text-gray-500 flex items-center gap-2
                 hover:border-gray-400 transition-colors duration-150">
  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5
               0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0
               11-3 0m3 0a1.5 1.5 0 10-3 0m-3.75 0H7.5m9-6h3.75m
               -3.75 0a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3
               0m-9.75 0h9.75" />
  </svg>
  絞り込み
  <% if active_filter_count > 0 %>
  <span class="bg-black text-white text-[9px] rounded-full
                   w-4 h-4 flex items-center justify-center
                   flex-shrink-0">
    <%= active_filter_count %>
  </span>
  <% end %>
</button>

<%= f.submit "検索",
        class: "h-9 px-5 bg-black text-white text-xs
                tracking-widest rounded-full cursor-pointer
                hover:bg-gray-800 transition-colors duration-150" %>

<% end %>