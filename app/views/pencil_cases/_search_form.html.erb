<%# app/views/pencil_cases/_search_form.html.erb %>
<%= search_form_for @q, url: pencil_cases_path,
      html: { class: "flex items-center gap-2" } do |f| %>

<%# キーワード検索 %>
<div class="relative flex-1">
  <div class="absolute inset-y-0 left-3 flex items-center
                pointer-events-none">
    <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196
                 5.196a7.5 7.5 0 0010.607 10.607z" />
    </svg>
  </div>
  <%= f.search_field :title_or_concept_cont,
          placeholder: "タイトル・コンセプトで検索",
          class: "w-full h-9 border border-gray-200 rounded-md
                  pl-9 pr-3 text-xs text-gray-900
                  placeholder-gray-300 bg-white
                  focus:border-gray-400 focus:outline-none
                  transition-colors duration-150" %>
</div>

<%# 検索ボタン %>
<%= f.submit "検索",
        class: "h-9 px-4 bg-black text-white text-xs
                tracking-widest rounded-md cursor-pointer
                hover:bg-gray-800 transition-colors duration-150
                flex-shrink-0" %>

<%# リセット %>
<% if params[:q].present? %>
<%= link_to "リセット", pencil_cases_path,
          class: "h-9 px-4 border border-gray-200 text-xs
                  text-gray-500 rounded-md hover:border-gray-400
                  flex items-center transition-colors duration-150
                  flex-shrink-0" %>
<% end %>
<% end %>