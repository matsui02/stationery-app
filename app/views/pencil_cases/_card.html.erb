<% large = local_assigns.fetch(:large, false) %>
<% rank = local_assigns[:rank] %>
<article class="relative bg-white rounded-xl shadow overflow-hidden <%= large ? 'h-[500px]' : 'h-[240px]' %>">

  <% if rank.present? %>
  <div class="absolute top-3 left-3 text-4xl z-10">
    <% case rank %>
    <% when 1 %>
    🥇
    <% when 2 %>
    🥈
    <% when 3 %>
    🥉
    <% end %>
  </div>
  <% end %>

  <% if pencil_case.images.attached? %>
  <%= image_tag pencil_case.images.first,
        class: "w-full #{large ? 'h-72' : 'h-40'} object-cover" %>
  <% else %>
  <div class="w-full <%= large ? 'h-72' : 'h-40' %> bg-gray-100 flex items-center justify-center text-gray-400">
    No Image
  </div>
  <% end %>

  <div class="p-4">
    <h3 class="<%= large ? 'text-2xl' : 'text-lg' %> font-semibold truncate">
      <%= pencil_case.title %>
    </h3>

    <p class="mt-2 text-sm text-gray-600 line-clamp-2">
      <%= pencil_case.concept %>
    </p>

    <div class="mt-4 flex items-center justify-between">
      <span class="text-sm text-gray-500">
        <%= pencil_case.user.name %>
      </span>

      <span class="text-xs text-gray-400">
        <%= pencil_case.created_at.strftime("%Y/%m/%d") %>
      </span>
    </div>
  </div>
</article>