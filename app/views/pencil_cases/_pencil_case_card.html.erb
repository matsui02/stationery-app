<div class="group cursor-pointer rounded-md overflow-hidden
            border border-gray-200 hover:border-gray-300
            hover:shadow-md transition-all duration-200
            flex flex-col h-[370px]" onclick="location.href='<%= pencil_case_path(pencil_case) %>'">

  <%# 画像エリア %>
  <div class="relative overflow-hidden aspect-[3/2] bg-gray-100">
    <% if pencil_case.image.attached? %>
    <%= image_tag pencil_case.image.variant(resize_to_fill: [400, 267]),
            class: "w-full h-full object-cover
                    group-hover:scale-105 transition-transform
                    duration-300" %>
    <% else %>
    <div class="w-full h-full bg-gradient-to-br
                  from-gray-100 to-gray-200 flex items-center
                  justify-center">
      <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182
                   0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25
                   0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5
                   0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5
                   1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5
                   -11.25h.008v.008h-.008V8.25zm.375 0a.375.375
                   0 11-.75 0 .375.375 0 01.75 0z" />
      </svg>
    </div>
    <% end %>

    <%# 投稿タイプバッジ %>
    <div class="absolute top-2 left-2">
      <span class="bg-white/90 text-gray-600 text-[9px]
                   tracking-wide px-1.5 py-0.5 rounded-sm">
        筆箱紹介
      </span>
    </div>

    <%# ハートアイコン（右上） %>
    <div class="absolute top-2 right-2" onclick="event.stopPropagation()">
      <button type="button" class="w-6 h-6 bg-white/90 rounded-full flex items-center
                     justify-center hover:bg-white
                     transition-colors duration-150">
        <svg class="w-3 h-3 text-gray-400 hover:text-red-400
                    transition-colors duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935
                   0-3.597 1.126-4.312 2.733-.715-1.607-2.377
                   -2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0
                   7.22 9 12 9 12s9-4.78 9-12z" />
        </svg>
      </button>
    </div>

    <%# ホバー時のオーバーレイ %>
    <div class="absolute inset-0 bg-black/40 flex items-center
                justify-center opacity-0 group-hover:opacity-100
                transition-opacity duration-200">
      <span class="text-white text-[10px] tracking-widest border
                   border-white/80 px-3 py-1.5 rounded-sm
                   bg-black/20">
        詳細を見る
      </span>
    </div>
  </div>

  <%# テキストエリア %>
  <div class="p-3 flex flex-col flex-1">

    <%# タイトル %>
    <p class="text-xs font-medium text-gray-900 leading-snug
              line-clamp-2 mb-2">
      <%= pencil_case.title.presence || "#{pencil_case.user.name}の筆箱" %>
    </p>

    <%# コンセプト %>
    <% if pencil_case.concept.present? %>
    <p class="text-[10px] text-gray-400 line-clamp-2
                leading-relaxed mb-2 flex-1">
      <%= pencil_case.concept %>
    </p>
    <% else %>
    <div class="flex-1"></div>
    <% end %>

    <%# 下部：ユーザー・いいね・日付 %>
    <div class="flex items-center justify-between pt-2
                border-t border-gray-100 mt-auto">
      <p class="text-[10px] text-gray-400 tracking-wide">
        <%= pencil_case.user.name %>
      </p>
      <div class="flex items-center gap-2">
        <span class="flex items-center gap-0.5 text-[10px] text-gray-300">
          <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935
                     0-3.597 1.126-4.312 2.733-.715-1.607-2.377
                     -2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0
                     7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
          0
        </span>
        <p class="text-[10px] text-gray-300">
          <%= pencil_case.created_at.strftime("%Y.%m.%d") %>
        </p>
      </div>
    </div>
  </div>
</div>